APP_NAME="PT Ekasa Cold Chain"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Zona waktu aplikasi = zona waktu jam yang tersimpan di database (created_at, dll).
# JANGAN diubah setelah ada data di database: data yang sudah tersimpan akan DITAFSIRKAN
# ULANG menurut zona waktu baru (bukan dikonversi), sehingga semua jam bergeser.
# Tampilan untuk pengguna (mis. "Diterima ... WIB") sudah dikonversi eksplisit ke Asia/Jakarta.
APP_TIMEZONE=UTC

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Development cepat: sqlite. Produksi: ganti ke mysql dan aktifkan baris DB_* di bawah.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ekasa
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
QUEUE_CONVERSIONS_BY_DEFAULT=false
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Konversi gambar WebP: auto | on | off (auto = aktif jika ekstensi GD/Imagick tersedia)
IMAGE_CONVERSIONS=auto

# Nomor WhatsApp awal untuk seeder Settings (boleh kosong; tombol WhatsApp disembunyikan jika kosong)
WHATSAPP_NUMBER=

# Admin panel (/admin) yang dibuat oleh seeder
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Draft translations in the admin (deepl or google). Empty = no draft button.
TRANSLATION_DRIVER=
TRANSLATION_API_KEY=
