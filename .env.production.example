# Template .env untuk PRODUKSI (shared hosting cPanel). Di server:
#     cp .env.production.example .env
# lalu isi nilai yang kosong / bertanda contoh (lihat DEPLOY.md bagian A6).
# Untuk development lokal pakai .env.example (`composer setup` menyalinnya otomatis).

APP_NAME="PT Ekasa Cold Chain"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ekasacoldchain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Shared hosting cPanel: MySQL/MariaDB. Nama DB & user di cPanel berawalan prefix akun,
# contoh: exos7198_ekasa. Buat lewat cPanel > MySQL Databases.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=exos7198_ekasa
DB_USERNAME=exos7198_ekasa
DB_PASSWORD=

# Session/cache/queue tanpa proses yang harus jalan terus (tidak ada Redis / queue worker).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
QUEUE_CONVERSIONS_BY_DEFAULT=false
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email: pakai akun email cPanel (Email Accounts). Host biasanya mail.ekasacoldchain.com
# dengan port 465 (scheme smtps) atau 587. Biarkan "log" jika situs tidak mengirim email.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mail.ekasacoldchain.com
MAIL_PORT=465
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@ekasacoldchain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Konversi gambar WebP: auto | on | off (auto = aktif jika ekstensi GD/Imagick tersedia)
IMAGE_CONVERSIONS=auto

# Nomor WhatsApp awal untuk seeder Settings (boleh kosong; tombol WhatsApp disembunyikan jika kosong)
WHATSAPP_NUMBER=

# Admin panel (/admin) yang dibuat oleh seeder. Ganti dengan email & password kuat sebelum db:seed.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@ekasacoldchain.com
ADMIN_PASSWORD=

# Draft translations in the admin (deepl or google). Empty = no draft button.
TRANSLATION_DRIVER=
TRANSLATION_API_KEY=
